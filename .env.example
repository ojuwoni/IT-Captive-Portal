# ==============================================
# Configuration Portail Captif SSO
# ==============================================
# Copier ce fichier vers .env et adapter les valeurs
# cp .env.example .env

# ==============================================
# Application
# ==============================================
APP_NAME=Captive Portal SSO
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false

# Clé secrète pour les sessions (générer avec: openssl rand -hex 32)
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# ==============================================
# Keycloak OIDC
# ==============================================
KEYCLOAK_URL=https://keycloak.example.com
KEYCLOAK_REALM=university
KEYCLOAK_CLIENT_ID=captive-portal
KEYCLOAK_CLIENT_SECRET=your-client-secret

# URL de callback (doit correspondre à celle configurée dans Keycloak)
CALLBACK_URL=http://portal.example.com/callback

# URL de redirection après connexion réussie
SUCCESS_REDIRECT_URL=https://www.google.com

# ==============================================
# Keycloak Admin (pour sync sessions)
# ==============================================
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
KEYCLOAK_ADMIN_CLIENT_SECRET=admin-secret

# ==============================================
# Redis
# ==============================================
REDIS_URL=redis://localhost:6379/0

# ==============================================
# Sessions
# ==============================================
# Durée de session en secondes (défaut: 8 heures)
SESSION_TIMEOUT=28800

# ==============================================
# Méthode d'autorisation réseau
# ==============================================
# Options: "nftables", "radius_coa" ou "pfsense_api"
# pfsense_api est RECOMMANDE pour les environnements pfSense
AUTH_METHOD=pfsense_api

# --- Configuration pfSense API (RECOMMANDE) ---
# Utiliser si AUTH_METHOD=pfsense_api
# Installer pfSense-pkg-API ou FauxAPI sur pfSense
PFSENSE_URL=https://192.168.1.1
PFSENSE_API_KEY=your-api-key
PFSENSE_API_SECRET=your-api-secret
PFSENSE_ALIAS_NAME=authorized_macs
PFSENSE_VERIFY_SSL=false

# --- Configuration nftables ---
# Utiliser si AUTH_METHOD=nftables (reseau plat uniquement)
NFT_TABLE=inet
NFT_CHAIN=filter
NFT_SET=allowed_macs

# --- Configuration RADIUS CoA ---
# Utiliser si AUTH_METHOD=radius_coa
RADIUS_SERVER=127.0.0.1
RADIUS_NAS_IP=10.0.0.1
RADIUS_SECRET=radius-secret
RADIUS_NAS_SECRET=radius-secret
RADIUS_COA_PORT=3799

# ==============================================
# Réseau
# ==============================================
NETWORK_INTERFACE=eth0

# ==============================================
# Thème - Identité
# ==============================================
THEME_COMPANY_NAME=Universite du Benin
THEME_PORTAL_TITLE=Portail WiFi
THEME_PORTAL_SUBTITLE=Authentification reseau

# ==============================================
# Thème - Logo et Favicon
# ==============================================
THEME_LOGO_URL=/static/logo.png
THEME_LOGO_WIDTH=120px
THEME_LOGO_HEIGHT=auto
THEME_FAVICON_URL=/static/favicon.ico

# ==============================================
# Thème - Couleurs
# ==============================================
# Couleur principale (boutons, liens)
THEME_PRIMARY_COLOR=#1a365d
THEME_PRIMARY_HOVER=#2d5a87

# Couleurs secondaires
THEME_SECONDARY_COLOR=#4a5568
THEME_ACCENT_COLOR=#48bb78
THEME_ERROR_COLOR=#e53e3e

# ==============================================
# Thème - Fond
# ==============================================
# Type: "gradient", "solid", ou "image"
THEME_BACKGROUND_TYPE=gradient
THEME_BACKGROUND_GRADIENT_START=#1a365d
THEME_BACKGROUND_GRADIENT_END=#2d5a87
# Si type=image, decommenter:
# THEME_BACKGROUND_IMAGE_URL=/static/background.jpg

# ==============================================
# Thème - Carte centrale
# ==============================================
THEME_CARD_BACKGROUND=#ffffff
THEME_CARD_BORDER_RADIUS=12px
THEME_CARD_SHADOW=0 20px 60px rgba(0,0,0,0.3)

# ==============================================
# Thème - Textes
# ==============================================
THEME_TEXT_PRIMARY=#2d3748
THEME_TEXT_SECONDARY=#4a5568
THEME_TEXT_MUTED=#718096

# ==============================================
# Thème - Boutons
# ==============================================
THEME_BUTTON_RADIUS=8px
THEME_BUTTON_PADDING=16px

# ==============================================
# Thème - Polices
# ==============================================
THEME_FONT_FAMILY=-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif
THEME_FONT_SIZE_BASE=16px
THEME_FONT_SIZE_SMALL=13px
THEME_FONT_SIZE_LARGE=24px

# ==============================================
# Thème - Textes personnalisables
# ==============================================
THEME_LOGIN_BUTTON_TEXT=Se connecter avec mon compte universitaire
THEME_SUCCESS_MESSAGE=Tu es maintenant connecte au reseau WiFi.
THEME_FOOTER_TEXT=En te connectant, tu acceptes les conditions d'utilisation du reseau.

# ==============================================
# Thème - Liens (optionnel)
# ==============================================
# THEME_TERMS_URL=https://example.com/cgu
# THEME_HELP_URL=https://example.com/aide

# ==============================================
# Thème - Langue
# ==============================================
THEME_LANG=fr
